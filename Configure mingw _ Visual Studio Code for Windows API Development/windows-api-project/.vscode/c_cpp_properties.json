{
    "configurations": [
        {
            "name": "MinGW-w64",
            "includePath": [
                "${workspaceFolder}/**",
                "/usr/x86_64-w64-mingw32/include/**"
            ],
            "defines": [
                "_WIN32",
                "UNICODE",
                "_UNICODE"
            ],
            "compilerPath": "/usr/bin/x86_64-w64-mingw32-gcc",
            "cStandard": "c11",
            "intelliSenseMode": "gcc-x64"
        }
    ],
    "version": 4
}
