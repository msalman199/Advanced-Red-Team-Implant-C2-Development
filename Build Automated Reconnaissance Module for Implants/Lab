#!/usr/bin/env python3
import time
import random
import os
import signal
import sys

class StealthModule:
    def __init__(self, min_delay=30, max_delay=300):
        self.min_delay = min_delay
        self.max_delay = max_delay
        self.running = True
        
        # Set up signal handlers for graceful shutdown
        signal.signal(signal.SIGINT, self.signal_handler)
        signal.signal(signal.SIGTERM, self.signal_handler)
    
    def signal_handler(self, signum, frame):
        print(f"\n[+] Received signal {signum}, shutting down gracefully...")
        self.running = False
    
    def random_delay(self):
        """Generate random delay to avoid detection patterns"""
        delay = random.randint(self.min_delay, self.max_delay)
        print(f"[+] Waiting {delay} seconds before next collection...")
        time.sleep(delay)
    
    def check_system_load(self):
        """Check system load to avoid running during high activity"""
        try:
            load_avg = os.getloadavg()[0]
            if load_avg > 2.0:  # Adjust threshold as needed
                print(f"[+] High system load detected ({load_avg:.2f}), delaying execution...")
                time.sleep(60)
                return False
            return True
        except:
            return True
    
    def run_periodic_collection(self, controller):
        """Run reconnaissance with stealth features"""
        collection_count = 0
        
        while self.running:
            if self.check_system_load():
                print(f"\n[+] Starting collection cycle #{collection_count + 1}")
                try:
                    controller.run_full_reconnaissance()
                    collection_count += 1
                except Exception as e:
                    print(f"[-] Collection failed: {e}")
                
                if self.running:  # Only delay if still running
                    self.random_delay()
            else:
                time.sleep(30)  # Wait and check load again
        
        print(f"[+] Completed {collection_count} collection cycles")

if __name__ == "__main__":
    from recon_controller import ReconController
    
    stealth = StealthModule(min_delay=60, max_delay=180)
    controller = ReconController()
    
    print("[+] Starting stealth reconnaissance module...")
    print("[+] Press Ctrl+C to stop gracefully")
    
    stealth.run_periodic_collection(controller)
EOF

