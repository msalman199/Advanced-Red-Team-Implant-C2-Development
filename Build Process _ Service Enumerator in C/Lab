void enumerate_processes() {
    DIR *proc_dir;
    struct dirent *entry;
    ProcessInfo proc;
    int count = 0;
    
    printf("=== RUNNING PROCESSES ===\n");
    printf("%-8s %-20s %-8s %-8s\n", "PID", "NAME", "STATE", "PPID");
    printf("%-8s %-20s %-8s %-8s\n", "----", "----", "-----", "----");
    
